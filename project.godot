[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="zombies"
3d_physics/layer_4="interactables"
3d_physics/layer_5="items"
3d_physics/layer_6="occluders"
3d_physics/layer_7="doors"
3d_physics/layer_8="window_panes"

[navigation]

3d/default_cell_size=0.15
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
